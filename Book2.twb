      <aliases enabled='yes' />
      <column caption='ev penetration %' datatype='real' default-format='p0.0%' name='[Calculation_0835147035062274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum ([total_vehicles_sold])=0 then null&#13;&#10;else sum ([electric_vehicles_sold])/sum([total_vehicles_sold]) END' />
      </column>
      <column caption=' EV Sales' datatype='integer' name='[Calculation_0835147036893187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='Total Vehicle Sales ' datatype='integer' name='[Calculation_0835147037184004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vehicles_sold])' />
      </column>
      <column caption='Maker Contribution %' datatype='real' name='[Calculation_0835147037433861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold]) / TOTAL(SUM([electric_vehicles_sold]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month-over-Month Growth %' datatype='real' name='[Calculation_0835147037601798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([electric_vehicles_sold]), -1) = 0 THEN NULL ELSE (SUM([electric_vehicles_sold]) - LOOKUP(SUM([electric_vehicles_sold]), -1))    / LOOKUP(SUM([electric_vehicles_sold]), -1)END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Year-over-Year Growth % ' datatype='real' name='[Calculation_0835147038445575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([electric_vehicles_sold]), -12) = 0 THEN NULL ELSE (SUM([electric_vehicles_sold]) - LOOKUP(SUM([electric_vehicles_sold]), -12))     / LOOKUP(SUM([electric_vehicles_sold]), -12)END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month label ' datatype='string' name='[Calculation_0835147038707720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [date]) + &apos; &apos; + STR(YEAR([date]))' />
      </column>
