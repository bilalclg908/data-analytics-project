                <semantic-value key='&quot;ANDAMAN &amp; NICOBAR ISLAND&quot;' value='&quot;Andaman &amp; Nicobar Islands&quot;' />
                <semantic-value key='&quot;DNH AND DD&quot;' value='&quot;Dadra and Nagar Haveli and Daman and Diu&quot;' />
              </semantic-values>
            </column>
