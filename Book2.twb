            <column-instance column='[Calculation_0835147036893187]' derivation='User' name='[usr:Calculation_0835147036893187:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0835147037184004]' derivation='User' name='[usr:Calculation_0835147037184004:qk]' pivot='key' type='quantitative' />
